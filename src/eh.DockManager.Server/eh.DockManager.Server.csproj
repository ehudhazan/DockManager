<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>eh-dockmanager</AssemblyName>
    <RootNamespace>eh.DockManager.Server</RootNamespace>

    <!-- Fast-Load Trimmed + ReadyToRun + Dynamic PGO -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredPGO>true</TieredPGO>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>

    <!-- Reflection-based System.Text.Json is required by the dynamic control-plane payloads. -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>

    <!-- Strict Supply-Chain Security & CVE Gate -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>IL2026;IL2104;IL3050</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Date-based version: yyyy.M.d.<buildNumber>. BuildNumber is supplied by -p:BuildNumber
         (the Docker build arg), else read from the git commit count (local builds), else a
         date/time fallback so any redeploy still changes the version. -->
    <BuildNumber Condition="'$(BuildNumber)' == ''"></BuildNumber>
    <_BuildDate>$([System.DateTime]::UtcNow.ToString('yyyy.M.d'))</_BuildDate>
    <_FallbackBuildNumber>$([System.DateTime]::UtcNow.ToString('HHmm'))</_FallbackBuildNumber>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <Target Name="ResolveBuildVersion"
          BeforeTargets="GetAssemblyVersion;GenerateAssemblyInfo;CoreGenerateAssemblyInfo;CoreCompile">
    <Exec Command="git rev-list --count HEAD 2>/dev/null" ConsoleToMSBuild="true" IgnoreExitCode="true"
          StandardOutputImportance="low"
          Condition="'$(BuildNumber)' == '' and Exists('$(MSBuildProjectDirectory)/../../.git')">
      <Output TaskParameter="ConsoleOutput" PropertyName="_GitCommitCount" />
    </Exec>
    <PropertyGroup>
      <BuildNumber Condition="'$(_GitCommitCount)' != ''">$([System.String]::Copy('$(_GitCommitCount)').Trim())</BuildNumber>
      <BuildNumber Condition="'$(BuildNumber)' == ''">$(_FallbackBuildNumber)</BuildNumber>
      <Version>$(_BuildDate).$(BuildNumber)</Version>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

  <ItemGroup>
    <!-- Strictly Audited Tier-1 NuGet Allowlist -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-*" />
    <PackageReference Include="Fido2.AspNet" Version="4.3.2" />
    <PackageReference Include="KubernetesClient" Version="18.0.13" />
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens.Saml" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Keep reflection-driven libraries intact under PublishTrimmed. -->
    <TrimmerRootAssembly Include="YamlDotNet" />
    <TrimmerRootAssembly Include="Fido2" />
    <TrimmerRootAssembly Include="Fido2.Models" />
    <TrimmerRootAssembly Include="Fido2.AspNet" />
    <TrimmerRootAssembly Include="ITfoxtec.Identity.Saml2" />
    <TrimmerRootAssembly Include="KubernetesClient" />
    <TrimmerRootAssembly Include="Microsoft.IdentityModel.Tokens.Saml" />
    <TrimmerRootAssembly Include="System.ServiceModel.Primitives" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.batteries_v2" />
    <TrimmerRootAssembly Include="SQLitePCLRaw.core" />
  </ItemGroup>

</Project>
