<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <AssemblyName>eh-dockmanager</AssemblyName>
    <RootNamespace>eh.DockManager.Server</RootNamespace>

    <!-- Fast-Load Trimmed + ReadyToRun + Dynamic PGO -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>true</PublishReadyToRunComposite>
    <TieredPGO>true</TieredPGO>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <EventSourceSupport>false</EventSourceSupport>
    <XmlResolverIsNetworkingEnabledByDefault>false</XmlResolverIsNetworkingEnabledByDefault>

    <!-- Strict Supply-Chain Security & CVE Gate -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditLevel>low</NuGetAuditLevel>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>IL2026;IL2104;IL3050</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- Strictly Audited Tier-1 NuGet Allowlist -->
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0-*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="11.0.0-*" />
    <PackageReference Include="Fido2.AspNet" Version="4.3.2" />
    <PackageReference Include="KubernetesClient" Version="18.0.13" />
    <PackageReference Include="ITfoxtec.Identity.Saml2" Version="4.21.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.12" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens.Saml" Version="8.23.0" />
  </ItemGroup>

</Project>
